###############################################################################
# Gazelle Genreting BUILD.bzl files
###############################################################################
bazel_dep(name = "gazelle", version = "0.51.3")
# Required by "@aspect_rules_py//uv:defs.bzl", "gazelle_python_manifest"
bazel_dep(name = "platforms", version = "1.1.0")
# It means that this line is required even if we do not use rules_python anywhere
bazel_dep(name = "rules_python", version = "2.0.2")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_oci", version = "2.2.7")
bazel_dep(name = "tar.bzl", version = "0.10.5")
bazel_dep(name = "bazel_env.bzl", version = "0.7.2")

bazel_dep(name = "bazel_lib", version = "3.2.2")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5", repo_name = None)  # force a recent version that works with v3
bazel_dep(name = "aspect_rules_lint", version = "2.0.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2")


###############################################################################
# Module extensions
###############################################################################

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//tools:tools.lock.json")
use_repo(multitool, "multitool")












