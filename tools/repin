#!/usr/bin/env bash

# # After adding or upgrading a third-party dependency, run this script to
# # regenerate the language lockfiles. Also run once after `aspect init` to
# # materialize the placeholder lockfiles the template ships with.
# set -o errexit -o nounset -o pipefail

# cd "$(dirname "$0")/.."

# If fails, then stop, ut keep the terminal open so that the output is visible
set -o errexit -o nounset -o pipefail

trap 'echo "Script failed. Press Enter to close..."; read' ERR


# Regenerate the curated bazelrc preset (bazelrc-preset.bzl). Keeps
# bazel/preset.bazelrc in sync so //bazel:preset.update_test passes.
bazel run //bazel:preset.update

# Python: regenerate uv.lock from pyproject.toml (uv reads pyproject + lock).
bazel run @uv -- lock

# Regenerate the Gazelle Python manifest mapping file
bazel run //:gazelle_python_manifest.update

# Accept any resulting MODULE.bazel.lock changes.
bazel mod deps --lockfile_mode=update

# Automatically run gazelle to update BUILD files
bazel run //:gazelle
